# Copy to .env. Never commit the filled file.
POSTGRES_PASSWORD=rag
RAG_DEEPSEEK_URL=https://api.deepseek.com/chat/completions
RAG_DEEPSEEK_MODEL=
RAG_DEEPSEEK_KEY=
# Rewrite always disables thinking; this switch applies to streamed answers.
RAG_DEEPSEEK_THINKING=disabled
RAG_OUTPUT_TOKENS=4096
# Set the full endpoint for your region and workspace.
RAG_EMBEDDING_URL=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/api/v1/services/embeddings/text-embedding/text-embedding
RAG_EMBEDDING_KEY=
RAG_EMBEDDING_MODEL=qwen3.7-text-embedding-flash
RAG_EMBEDDING_DIMENSION=1024
RAG_RERANK_URL=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
RAG_RERANK_KEY=
RAG_RERANK_MODEL=qwen3.7-text-rerank
RAG_MODEL_TIMEOUT=60
RAG_MODEL_RETRIES=2
# 可选：三类模型分别覆盖全局超时/重试，未设置时继承上面的值。
# RAG_DEEPSEEK_TIMEOUT=90
# RAG_EMBEDDING_TIMEOUT=60
# RAG_RERANK_TIMEOUT=30
# RAG_DEEPSEEK_RETRIES=2
# RAG_EMBEDDING_RETRIES=2
# RAG_RERANK_RETRIES=1
RAG_MODEL_CONCURRENCY=4
RAG_CHUNK_TARGET=600
RAG_CHUNK_MAX=900
RAG_CHUNK_OVERLAP=80
RAG_MAX_UPLOAD_BYTES=52428800
RAG_MAX_PDF_PAGES=500
RAG_PARSE_TIMEOUT=900
RAG_CONVERT_TIMEOUT=120
# Bind this host directory read-only into /data/sources.
SOURCES_HOST_PATH=./data/sources
FRONTEND_PORT=8080
